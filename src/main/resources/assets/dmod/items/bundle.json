{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "fallback": { "type": "minecraft:model", "model": "dmod:item/bundle" },
    "cases": [
      {
        "when": ["ITEM_GUI"],
        "model": {
          "type": "minecraft:condition",
          "property": "dmod:bundle/has_selected_item",
          "on_false": { "type": "minecraft:model", "model": "dmod:item/bundle" },
          "on_true": {
            "type": "minecraft:composite",
            "models": [
              { "type": "minecraft:model", "model": "dmod:item/bundle_open_back" },
              { "type": "dmod:bundle/selected_item" },
              { "type": "minecraft:model", "model": "dmod:item/bundle_open_front" }
            ]
          }
        }
      }
    ]
  }
}
